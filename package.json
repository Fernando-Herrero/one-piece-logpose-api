{
  "name": "api-onepiece",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/data dist/data && cp -r public dist/public",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec \"tsc && node dist/index.js\"",
    "usersSeed": "tsx src/api/users/users.seed.ts",
    "postsSeed": "tsx src/api/posts/posts.seed.ts",
    "activitySeed": "tsx src/api/activity.seed.ts",
    "seed": "npm run usersSeed && npm run postsSeed"
  },
